# unsupported.test — constructs outside the supported SQL subset must return
# an error (never crash) and are reported as waived by the runner (acceptance
# criterion a6). Run with --strict to count them as failures instead.
#
# ORDER BY, LIMIT/OFFSET, DISTINCT, aggregations, GROUP BY and HAVING are now
# part of the supported subset (implemented in this module) and are tested in
# orderby.test / limit-offset.test / distinct.test / aggregate.test /
# groupby.test. HAVING without an aggregate yields a runtime SQLError (matching
# SQLite "HAVING clause on a non-aggregate query"), recorded here as an error.
#
# LIKE/GLOB/BETWEEN/IN/IS/NOT/AND/OR and CAST are part of the expression
# subset and are deliberately absent here; see expr.test for them.

statement ok
CREATE TABLE t (a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1, 'x')

statement error
SELECT a FROM t HAVING a > 0

query I rowsort
SELECT a FROM t UNION SELECT a FROM t
----
1

query I rowsort
SELECT CASE WHEN a > 0 THEN 1 ELSE 0 END FROM t
----
1

query I rowsort
SELECT abs(a) FROM t
----
1

query I rowsort
SELECT coalesce(a, b) FROM t
----
1

query I rowsort
SELECT (SELECT a FROM t) FROM t
----
1

statement error
CREATE INDEX idx ON t (a)

statement error
CREATE VIEW v AS SELECT * FROM t

statement error
ALTER TABLE t ADD COLUMN c INTEGER

statement error
BEGIN

statement error
PRAGMA table_info(t)
