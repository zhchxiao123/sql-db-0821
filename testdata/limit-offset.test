# limit-offset.test — LIMIT and OFFSET (both `LIMIT n OFFSET m` and the
# SQLite `LIMIT m,n` comma form), including the edge cases: LIMIT 0 yields no
# rows, an over-limit OFFSET yields no rows, a negative LIMIT means unlimited,
# and OFFSET requires a LIMIT (error, matching sqlite3).
# Every expected value below was verified against sqlite3 3.51.0.

statement ok
CREATE TABLE t (a INTEGER)

statement ok
INSERT INTO t VALUES (1)

statement ok
INSERT INTO t VALUES (2)

statement ok
INSERT INTO t VALUES (3)

statement ok
INSERT INTO t VALUES (4)

statement ok
INSERT INTO t VALUES (5)

query I
SELECT a FROM t LIMIT 2
----
1
2

query I
SELECT a FROM t LIMIT 2 OFFSET 1
----
2
3

query I
SELECT a FROM t LIMIT 0
----

query I
SELECT a FROM t LIMIT -1
----
1
2
3
4
5

query I
SELECT a FROM t LIMIT 100
----
1
2
3
4
5

query I
SELECT a FROM t LIMIT 2 OFFSET 100
----

# SQLite comma form: LIMIT <skip>, <take>
query I
SELECT a FROM t LIMIT 2, 1
----
3

# OFFSET without a preceding LIMIT is an error.
statement error
SELECT a FROM t OFFSET 1

statement ok
DROP TABLE t